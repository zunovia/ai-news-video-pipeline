{
  "news": {
    "rss_feeds": [
      "https://techcrunch.com/category/artificial-intelligence/feed/",
      "https://www.theverge.com/rss/ai-artificial-intelligence/index.xml",
      "https://www.technologyreview.com/topic/artificial-intelligence/feed",
      "https://venturebeat.com/feed",
      "https://www.wired.com/feed/tag/ai/latest/rss",
      "https://arstechnica.com/ai/feed/",
      "https://blog.google/innovation-and-ai/technology/ai/rss/",
      "https://openai.com/news/rss.xml",
      "https://gigazine.net/news/rss_2.0/",
      "https://rss.itmedia.co.jp/rss/2.0/aiplus.xml",
      "https://www.publickey1.jp/atom.xml"
    ],
    "google_cse": {
      "api_key_env": "GOOGLE_CSE_API_KEY",
      "engine_id_env": "GOOGLE_CSE_ENGINE_ID",
      "queries": [
        "AI news today",
        "artificial intelligence breakthrough",
        "AI robot children education",
        "AI 最新ニュース 今日"
      ]
    },
    "max_articles": 50,
    "max_per_feed": 30,
    "top_n": 5,
    "topic_dedup": true,
    "past_story_dedup": true,
    "exclude_keywords": [],
    "cluster_pool_size": 15,
    "fetch_full_text": true
  },
  "llm": {
    "provider": "claude",
    "gemini": {
      "api_key_file": ".gemini_api_key",
      "model": "gemini-2.5-flash",
      "max_tokens_scoring": 200,
      "max_tokens_script": 8000,
      "max_tokens_enrich": 1000
    },
    "claude": {
      "auth_mode": "subscription",
      "api_key_env": "ANTHROPIC_API_KEY",
      "model": "claude-haiku-4-5",
      "max_tokens_scoring": 200,
      "max_tokens_script": 8000,
      "max_tokens_enrich": 1000
    }
  },
  "script": {
    "allow_fallback": true,
    "max_estimated_sec": 205,
    "factcheck": {
      "enabled": true,
      "auto_fix": true
    }
  },
  "tts": {
    "provider": "gemini",
    "language": "ja-JP",
    "voice": "",
    "speaking_rate": 1.0,
    "pitch": 0.0,
    "credit": "Google Gemini TTS",
    "options": {
      "model": "gemini-3.8-flash-tts",
      "voice": "Kore",
      "style": "bright, friendly, upbeat news explainer, brisk pace",
      "base_url": "http://localhost:50021",
      "speaker": 14
    }
  },
  "pipeline": {
    "daily_video_enabled": false
  },
  "shorts": {
    "per_topic": true,
    "topics_per_day": 3,
    "max_topic_duration_sec": 75,
    "burn_captions": true,
    "template_variants": [
      "variants/broadcast/slide_shorts.html",
      "variants/editorial/slide_shorts.html",
      "variants/soft/slide_shorts.html"
    ]
  },
  "video": {
    "resolution": [1920, 1080],
    "shorts_resolution": [1080, 1920],
    "shorts_max_duration_sec": 170,
    "fps": 30,
    "silence_duration": 3.5,
    "padding_before": 0.3,
    "padding_after": 0.3,
    "transition": "crossfade",
    "transition_duration": 0.5,
    "motion": {
      "enabled": true,
      "max_zoom": 1.05
    }
  },
  "bgm": {
    "enabled": true,
    "file": "assets/bgm/bgm_default.mp3",
    "volume": 0.04
  },
  "youtube": {
    "client_secrets_file": "client_secret.json",
    "token_file": "state/youtube_token.json",
    "default_category_id": "28",
    "default_tags": ["AI", "人工知能", "AIニュース", "生成AI", "AI活用", "AI入門", "初心者", "ポンテ", "AI教室"],
    "initial_privacy": "private",
    "custom_thumbnail": true
  },
  "paths": {
    "video_engine_dir": "../911-plan",
    "state_dir": "state",
    "output_dir": "output",
    "templates_dir": "templates",
    "assets_dir": "assets"
  },
  "channel": {
    "name": "ポンテのAI教室",
    "character": "ポンテ",
    "tagline": "むずかしいAIを、かんたんに。",
    "target_audience": "AI初心者の大人（専門知識のない人にやさしく解説）"
  }
}
